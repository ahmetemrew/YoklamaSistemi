# Environment Variables Example
# .env dosyası oluşturup bu değerleri kopyalayın

# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_PATH=./database/yoklama.db

# CORS (Production için)
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.100:3000

# Session (Gelecekte auth için)
# SESSION_SECRET=your-secret-key-here

# Backup (Gelecekte)
# BACKUP_ENABLED=true
# BACKUP_DIR=./backups
# BACKUP_SCHEDULE=0 2 * * *

# Email (Gelecekte bildirim için)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-password
