{
  "name": "yoklama-exe",
  "version": "1.0.0",
  "description": "Tek .exe Yoklama Sistemi",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node18-win-x64 --output YoklamaSistemi.exe --compress GZip"
  },
  "pkg": {
    "assets": [
      "index.html",
      "app.js"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "socket.io": "^4.6.0",
    "better-sqlite3": "^11.5.0",
    "qrcode": "^1.5.3",
    "archiver": "^6.0.1",
    "uuid": "^9.0.1",
    "localtunnel": "^2.0.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
