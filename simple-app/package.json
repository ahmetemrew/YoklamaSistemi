{
  "name": "yoklama-sistemi",
  "version": "1.0.0",
  "description": "QR Kod Tabanlı Kolay Yoklama Sistemi",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-setup": "npm install && electron-builder --win --x64"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "socket.io": "^4.6.0",
    "qrcode": "^1.5.3",
    "archiver": "^6.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.yoklama.sistem",
    "productName": "Yoklama Sistemi",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yoklama Sistemi",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "files": [
      "**/*",
      "!node_modules/better-sqlite3/build/Release/obj/**/*",
      "node_modules/better-sqlite3/build/Release/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "compression": "maximum"
  }
}
